#!/bin/bash
# -----------------------------------------------------------------------------
# Build the HSM-ROS2 workspace of the gui container and install the CyberiadaPro
# hsm-ros2 plugin for the user. Run it again after adding a ROS repo.
#
# The ROS repos of the mounted repos dir ($HSM_ROS2_SRC: the ros2-repos list and
# $HSM_ROS2_REPOS, see ros2_repos in lib.sh) are linked into $HSM_ROS2_WS/src, the
# links of the repos no longer listed are pruned, the missing dependencies are installed by
# rosdep (--no-rosdep skips it; they last until the container is recreated) and
# the workspace is built. The other arguments go to colcon build. The image's
# /usr/local/bin/hsm-ros2-init runs this script from the mounted repo.
#
# Copyright (C) 2026 Alexey Fedoseev <aleksey@fedoseev.net>
#
# This program is free software; you can redistribute it and/or modify it under
# the terms of the GNU Lesser General Public License, version 3 or later.
# -----------------------------------------------------------------------------
set -eu

here=$(cd "$(dirname "$0")" && pwd)
. "$here/lib.sh"

ROSDEP=1
if [ "${1:-}" = --no-rosdep ]; then ROSDEP=0; shift; fi

ws=${HSM_ROS2_WS:?the workspace is not set (run the container with run-gui.sh)}
src=${HSM_ROS2_SRC:?the repos dir is not set (run the container with run-gui.sh)}

# src/<repo> -> the repo at its host path (unless the repo is mounted right there);
# a link to a repo not listed (any more) goes
repos=$(ros2_repos "$src")
mkdir -p "$ws/src"
for link in "$ws/src"/*; do
    if [ -L "$link" ] && ! grep -qxF "$(readlink "$link")" <<< "$repos"; then
        rm -f "$link"; echo "unlinked $link"
    fi
done
while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    link="$ws/src/$(basename "$repo")"
    if [ "$repo" = "$link" ]; then
        continue
    elif [ -L "$link" ] || [ ! -e "$link" ]; then
        ln -sfn "$repo" "$link"
    else
        echo "warning: $link exists, not linked to $repo" >&2
    fi
done <<< "$repos"
echo "ros repos: $(cd "$ws/src" && echo *)"

set +u
. "/opt/ros/$ROS_DISTRO/setup.bash"
set -u

if [ "$ROSDEP" -eq 1 ]; then
    # the local keys of our packages and the Cyberiada toolchain (rosdep.yaml)
    list=/etc/ros/rosdep/sources.list.d/50-hsm-ros2.list
    entry="yaml file://$here/rosdep.yaml"
    if [ "$(cat "$list" 2>/dev/null)" != "$entry" ]; then
        echo "$entry" | sudo tee "$list" >/dev/null
        "$here/retry" rosdep update --rosdistro "$ROS_DISTRO"
    elif [ ! -d "$HOME/.ros/rosdep/sources.cache" ]; then
        "$here/retry" rosdep update --rosdistro "$ROS_DISTRO"
    fi
    "$here/retry" sudo apt-get update
    "$here/retry" rosdep install --from-paths "$ws/src" --ignore-src -y -r --rosdistro "$ROS_DISTRO"
fi

cd "$ws"
colcon build --base-paths src "$@"

set +u
. "$ws/install/setup.bash"
set -u
ros2 run hsm_generator hsm_generator --install-editor-plugin
echo "done: open a new shell (or source $ws/install/setup.bash) and run CyberiadaPro"
