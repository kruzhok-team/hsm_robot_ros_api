#!/bin/sh
# -----------------------------------------------------------------------------
# retry [-n TIMES] [-d DELAY] CMD...: run CMD until it succeeds, TIMES at most
# (default $RETRY_TIMES or 5), waiting DELAY, 2*DELAY, ... seconds in between
# (default $RETRY_DELAY or 10). For the network steps: apt, curl, rosdep.
#
# Copyright (C) 2026 Alexey Fedoseev <aleksey@fedoseev.net>
#
# This program is free software; you can redistribute it and/or modify it under
# the terms of the GNU Lesser General Public License, version 3 or later.
# -----------------------------------------------------------------------------
set -u

times=${RETRY_TIMES:-5}
delay=${RETRY_DELAY:-10}
while getopts n:d: opt; do
    case "$opt" in
        n) times=$OPTARG ;;
        d) delay=$OPTARG ;;
        *) echo "usage: retry [-n TIMES] [-d DELAY] CMD..." >&2; exit 2 ;;
    esac
done
shift $((OPTIND - 1))
[ $# -gt 0 ] || { echo "usage: retry [-n TIMES] [-d DELAY] CMD..." >&2; exit 2; }

i=1
while :; do
    "$@" && exit 0
    rc=$?
    if [ "$i" -ge "$times" ]; then
        echo "retry: giving up after $times attempts (exit $rc): $*" >&2
        exit "$rc"
    fi
    echo "retry: attempt $i/$times failed (exit $rc), again in $((delay * i))s: $*" >&2
    sleep $((delay * i))
    i=$((i + 1))
done
